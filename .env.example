# Copie este arquivo para .env e ajuste os valores.
# O .env NÃO deve ser versionado (já está no .gitignore).

FLASK_ENV=development
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Deixe em branco para usar SQLite local (chamati_dev.db).
# Em produção, o Render injeta esta variável automaticamente.
DATABASE_URL=

PORT=5000
